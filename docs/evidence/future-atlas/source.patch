diff --git a/src/features/future/FutureActions.tsx b/src/features/future/FutureActions.tsx
new file mode 100644
index 0000000..117537a
--- /dev/null
+++ b/src/features/future/FutureActions.tsx
@@ -0,0 +1,180 @@
+import { useState } from "react";
+import type { FuturePayload, FuturePersonal } from "./schema";
+import { actionLabels, horizonLabels, preparationCounts } from "./selectors";
+export type SavePersonal = (patch: Partial<FuturePersonal>) => Promise<boolean>;
+export function FutureActions({
+  payload: p,
+  personal,
+  onSave,
+}: {
+  payload: FuturePayload;
+  personal: FuturePersonal;
+  onSave: SavePersonal;
+}) {
+  const counts = preparationCounts(p, personal);
+  return (
+    <>
+      <div className="future-section-heading">
+        <span className="future-kicker">04 / MA PRÉPARATION</span>
+        <h2>Se préparer, un pas à la fois.</h2>
+        <p>
+          Votre feuille de route privée. La progression reflète uniquement les
+          statuts enregistrés sur cet appareil.
+        </p>
+      </div>
+      <div className="future-progress">
+        <span>
+          <b>
+            {counts.done} / {p.actions.length}
+          </b>{" "}
+          actions terminées
+        </span>
+        <progress
+          value={counts.done}
+          max={Math.max(1, p.actions.length)}
+          aria-label="Actions terminées"
+        />
+        <ul>
+          {Object.entries(counts).map(([key, count]) => (
+            <li key={key}>
+              {actionLabels[key as keyof typeof actionLabels]} : {count}
+            </li>
+          ))}
+        </ul>
+      </div>
+      <div className="future-roadmap">
+        {(["now", "3m", "12m"] as const).map((h, i) => (
+          <section className="future-roadmap-stage" key={h}>
+            <h3>
+              <span aria-hidden="true">0{i + 1}</span>
+              {horizonLabels[h]}
+            </h3>
+            {p.actions
+              .filter((a) => a.horizon === h)
+              .map((a) => (
+                <ActionCard
+                  key={a.id}
+                  action={a}
+                  saved={personal.actions[a.id]}
+                  payload={p}
+                  onSave={onSave}
+                />
+              ))}
+            {!p.actions.some((a) => a.horizon === h) && (
+              <p className="future-missing">Aucune action renseignée.</p>
+            )}
+          </section>
+        ))}
+      </div>
+    </>
+  );
+}
+function ActionCard({
+  action: a,
+  saved,
+  payload: p,
+  onSave,
+}: {
+  action: FuturePayload["actions"][number];
+  saved: FuturePersonal["actions"][string] | undefined;
+  payload: FuturePayload;
+  onSave: SavePersonal;
+}) {
+  const [draft, setDraft] = useState<{
+      status: keyof typeof actionLabels;
+      result: string;
+    } | null>(null),
+    [busy, setBusy] = useState(false),
+    [message, setMessage] = useState(""),
+    [failed, setFailed] = useState(false);
+  const value = draft || saved || { status: "todo" as const, result: "" };
+  return (
+    <article className="quiet-panel future-action">
+      <span className="future-badge">
+        {actionLabels[saved?.status || "todo"]}
+      </span>
+      <h4>{a.title}</h4>
+      <p>
+        <b>Compétence :</b> {a.skill}
+      </p>
+      <p>
+        <b>Impact proposé :</b> {a.description}
+      </p>
+      <div className="future-decisive">
+        <b>Test décisif</b>
+        <p>{a.decisiveTest}</p>
+      </div>
+      <details>
+        <summary>Effort et scénarios concernés</summary>
+        <p>
+          {a.effortHours === null
+            ? "Effort non documenté."
+            : a.effortHours + " h — " + a.effortEvidence}
+        </p>
+        <p>
+          Scénarios concernés :{" "}
+          {a.scenarioIds
+            .map((id) => p.scenarios.find((s) => s.id === id)?.title)
+            .join(" · ") || "Non renseigné."}
+        </p>
+      </details>
+      <form
+        onSubmit={async (e) => {
+          e.preventDefault();
+          setBusy(true);
+          setFailed(false);
+          const ok = await onSave({ actions: { [a.id]: value } });
+          if (ok) {
+            setDraft(null);
+            setMessage("Action enregistrée sur cet appareil.");
+          } else {
+            setFailed(true);
+            setMessage(
+              "Échec de sauvegarde. Vos saisies sont conservées ici ; réessayez.",
+            );
+          }
+          setBusy(false);
+        }}
+      >
+        <label>
+          Suivi de « {a.title} »
+          <select
+            disabled={busy}
+            value={value.status}
+            onChange={(e) => {
+              setDraft({
+                ...value,
+                status: e.target.value as keyof typeof actionLabels,
+              });
+              setMessage("Modification non enregistrée.");
+            }}
+          >
+            {Object.entries(actionLabels).map(([key, label]) => (
+              <option key={key} value={key}>
+                {label}
+              </option>
+            ))}
+          </select>
+        </label>
+        <label>
+          Résultat de « {a.title} »
+          <textarea
+            disabled={busy}
+            value={value.result}
+            maxLength={4000}
+            onChange={(e) => {
+              setDraft({ ...value, result: e.target.value });
+              setMessage("Modification non enregistrée.");
+            }}
+          />
+        </label>
+        <button className="secondary" disabled={busy}>
+          {busy ? "Enregistrement…" : "Enregistrer l’action"}
+        </button>
+        <p className="future-save-status" role={failed ? "alert" : "status"}>
+          {message || "Votre suivi reste privé."}
+        </p>
+      </form>
+    </article>
+  );
+}
diff --git a/src/features/future/FutureDetail.tsx b/src/features/future/FutureDetail.tsx
new file mode 100644
index 0000000..a3ebde1
--- /dev/null
+++ b/src/features/future/FutureDetail.tsx
@@ -0,0 +1,366 @@
+import { useEffect, useRef, useState } from "react";
+import { download } from "../backup";
+import { blobOf, now } from "../../data/model";
+import { radarReaderHTML } from "../aiRadar/import";
+import {
+  futureDb,
+  type FutureVersion,
+  type FutureDocument,
+  type FutureChange,
+} from "./db";
+import {
+  moduleLabels,
+  personalSchema,
+  statusLabels,
+  type FuturePayload,
+  type FuturePersonal,
+} from "./schema";
+import { renderFutureHTML } from "./html";
+import { useLive } from "./hooks";
+import { formatDate } from "./selectors";
+import { FutureOverview } from "./FutureOverview";
+import { FutureTimeline } from "./FutureTimeline";
+import { FutureScenarioCompare } from "./FutureScenarioCompare";
+import { FutureSignals } from "./FutureSignals";
+import { FutureActions } from "./FutureActions";
+import { FutureSources } from "./FutureSources";
+import { FuturePersonalNotes } from "./FuturePersonalNotes";
+const verdicts = {
+  integrer: "Intégrer",
+  surveiller: "À surveiller",
+  ecarter: "Écarter",
+};
+export default function FutureDetail({
+  documentId,
+  onBack,
+  initialSection = "overview",
+}: {
+  documentId: string;
+  onBack: () => void;
+  initialSection?: string;
+}) {
+  const { value: dossier, error: documentError } = useLive(
+    () => futureDb.documents.get(documentId),
+    [documentId],
+    undefined as FutureDocument | undefined,
+  );
+  const { value: versions, error: versionsError } = useLive(
+    () =>
+      futureDb.versions
+        .where("documentId")
+        .equals(documentId)
+        .sortBy("revision"),
+    [documentId],
+    [] as FutureVersion[],
+  );
+  const { value: saved, error: personalError } = useLive(
+    () => futureDb.personal.get(documentId),
+    [documentId],
+    undefined as FuturePersonal | undefined,
+  );
+  const { value: events, error: eventsError } = useLive(
+    () => futureDb.changes.where("documentId").equals(documentId).sortBy("at"),
+    [documentId],
+    [] as FutureChange[],
+  );
+  const [versionId, setVersionId] = useState(""),
+    [payload, setPayload] = useState<FuturePayload | null>(null),
+    [error, setError] = useState(""),
+    [message, setMessage] = useState(""),
+    [preview, setPreview] = useState("");
+  const heading = useRef<HTMLHeadingElement>(null),
+    focused = useRef(false),
+    previewButton = useRef<HTMLButtonElement>(null);
+  const chosen = versionId || dossier?.latest;
+  useEffect(() => {
+    let active = true;
+    setPreview("");
+    if (chosen)
+      futureDb.contents
+        .get(chosen)
+        .then((c) => {
+          if (active) {
+            setPayload(c?.payload || null);
+            if (!c)
+              setError(
+                "Snapshot indisponible. Revenez à la liste ou restaurez une sauvegarde.",
+              );
+          }
+        })
+        .catch((e) => {
+          if (active) setError(String(e));
+        });
+    return () => {
+      active = false;
+    };
+  }, [chosen]);
+  useEffect(() => {
+    if (!payload || focused.current) return;
+    focused.current = true;
+    if (initialSection === "overview") heading.current?.focus();
+    else
+      (
+        document.getElementById("future-module-" + initialSection) ||
+        heading.current
+      )?.focus();
+  }, [payload, initialSection]);
+  async function run(action: () => Promise<unknown>, success = "") {
+    setError("");
+    try {
+      await action();
+      if (success) setMessage(success);
+      return true;
+    } catch (e) {
+      setError(e instanceof Error ? e.message : String(e));
+      return false;
+    }
+  }
+  const loadError =
+    documentError || versionsError || personalError || eventsError;
+  if (!payload)
+    return (
+      <div>
+        <button onClick={onBack}>← Tous les dossiers</button>
+        {loadError || error ? (
+          <p role="alert">{loadError || error}</p>
+        ) : (
+          <p role="status">Ouverture du dossier…</p>
+        )}
+      </div>
+    );
+  const p = payload,
+    personal = saved || personalSchema.parse({ documentId, updatedAt: now() }),
+    activeVersion = versions.find((v) => v.id === chosen);
+  const patch = (value: Partial<FuturePersonal>) =>
+    run(
+      () => futureDb.updatePersonal(documentId, value),
+      "Modifications enregistrées sur cet appareil.",
+    );
+  const components = {
+    timeline: <FutureTimeline key={chosen} payload={p} />,
+    scenarios: <FutureScenarioCompare payload={p} />,
+    signals: <FutureSignals payload={p} />,
+    actions: <FutureActions payload={p} personal={personal} onSave={patch} />,
+    sources: <FutureSources payload={p} personal={personal} onSave={patch} />,
+    changes: (
+      <>
+        <div className="future-section-heading">
+          <span className="future-kicker">HISTORIQUE</span>
+          <h2>Ce qui a changé.</h2>
+        </div>
+        <p>
+          Différences éditoriales de cette révision ; les versions précédentes
+          restent accessibles.
+        </p>
+        <ul>
+          {activeVersion?.changes.map((c, i) => (
+            <li key={i}>{c}</li>
+          ))}
+        </ul>
+        <details>
+          <summary>Historique local complet ({events.length})</summary>
+          <ul>
+            {[...events].reverse().map((e) => (
+              <li key={e.id}>
+                {formatDate(e.at)} — {e.description}
+              </li>
+            ))}
+          </ul>
+        </details>
+      </>
+    ),
+  };
+  return (
+    <article
+      className="future-detail"
+      data-document-motion={p.visualization.motion}
+    >
+      <button className="text-button future-back" onClick={onBack}>
+        ← Tous les dossiers
+      </button>
+      <header className="future-dossier-header">
+        <span className="future-kicker">
+          DOSSIER PROSPECTIF / RÉVISION {p.revision}
+        </span>
+        <h2 ref={heading} tabIndex={-1}>
+          {p.title}
+        </h2>
+        <p>
+          <span className="future-badge">{statusLabels[p.status]}</span>
+          {p.synthetic && (
+            <span className="future-badge">EXEMPLE SYNTHÉTIQUE</span>
+          )}
+        </p>
+        <p>
+          {verdicts[p.editorialDecision.verdict]} : {p.editorialDecision.reason}
+        </p>
+        <div className="future-tools">
+          <button
+            className="secondary"
+            aria-pressed={personal.favorite}
+            onClick={() => patch({ favorite: !personal.favorite })}
+          >
+            {personal.favorite ? "Retirer des favoris" : "Ajouter aux favoris"}
+          </button>
+          <label>
+            Version affichée
+            <select
+              value={chosen || ""}
+              onChange={(e) => setVersionId(e.target.value)}
+            >
+              {[...versions]
+                .sort((a, b) => b.revision - a.revision)
+                .map((v) => (
+                  <option key={v.id} value={v.id}>
+                    Révision {v.revision} · {formatDate(v.updatedAt)}
+                  </option>
+                ))}
+            </select>
+          </label>
+        </div>
+        <details className="future-file-tools">
+          <summary>Exports, original et empreinte</summary>
+          <div className="future-tools">
+            <button
+              onClick={() =>
+                run(async () => {
+                  download(
+                    blobOf(
+                      new TextEncoder().encode(JSON.stringify(p, null, 2)),
+                      "application/json",
+                    ),
+                    p.documentId + ".json",
+                  );
+                })
+              }
+            >
+              Exporter JSON
+            </button>
+            <button
+              onClick={() =>
+                run(async () => {
+                  download(
+                    blobOf(
+                      new TextEncoder().encode(renderFutureHTML(p)),
+                      "text/html",
+                    ),
+                    p.documentId + ".html",
+                  );
+                })
+              }
+            >
+              Exporter HTML portable
+            </button>
+            <button
+              onClick={() =>
+                run(async () => {
+                  if (!chosen || !activeVersion) return;
+                  const o = await futureDb.originals.get(chosen);
+                  if (o)
+                    download(
+                      blobOf(
+                        o.bytes,
+                        activeVersion.kind === "json"
+                          ? "application/json"
+                          : "text/html",
+                      ),
+                      activeVersion.filename,
+                    );
+                })
+              }
+            >
+              Télécharger l’original
+            </button>
+            {activeVersion?.kind !== "json" && (
+              <button
+                ref={previewButton}
+                onClick={() =>
+                  run(async () =>
+                    setPreview(
+                      radarReaderHTML(
+                        new TextEncoder().encode(
+                          renderFutureHTML(p).replace(
+                            "</head>",
+                            "<style>*,*::before,*::after{animation:none!important;transition:none!important}</style></head>",
+                          ),
+                        ),
+                      ),
+                    ),
+                  )
+                }
+              >
+                Voir l’aperçu HTML isolé
+              </button>
+            )}
+          </div>
+          <p className="future-caption">
+            Empreinte SHA-256 : {activeVersion?.sha256}
+          </p>
+        </details>
+        <p className="future-caption">
+          Les notes et le suivi personnel concernent le dossier, quelle que soit
+          la version affichée.
+        </p>
+      </header>
+      {(error || loadError) && (
+        <p role="alert" className="warning">
+          {error || loadError}
+        </p>
+      )}
+      <p className="future-save-status" role="status">
+        {message}
+      </p>
+      {preview && (
+        <section>
+          <button
+            onClick={() => {
+              setPreview("");
+              previewButton.current?.focus();
+            }}
+          >
+            Fermer l’aperçu
+          </button>
+          <iframe
+            title="Aperçu HTML isolé du dossier"
+            sandbox=""
+            referrerPolicy="no-referrer"
+            srcDoc={preview}
+            className="future-preview"
+          />
+        </section>
+      )}
+      <nav className="future-module-nav" aria-label="Modules du dossier">
+        <a href="#future-atlas-overview">Vue d’ensemble</a>
+        {p.visualization.modules
+          .filter((m) => m !== "changes")
+          .map((m) => (
+            <a key={m} href={"#future-module-" + m}>
+              {m === "scenarios"
+                ? "Scénarios"
+                : m === "sources"
+                  ? "Sources"
+                  : moduleLabels[m]}
+            </a>
+          ))}
+        <a href="#future-personal-notes">Mon carnet</a>
+        {p.visualization.modules.includes("changes") && (
+          <a href="#future-module-changes">Évolutions</a>
+        )}
+      </nav>
+      <FutureOverview payload={p} />
+      {p.visualization.modules.map((module) => (
+        <section
+          className="future-module"
+          id={"future-module-" + module}
+          tabIndex={-1}
+          key={module}
+        >
+          {components[module]}
+        </section>
+      ))}
+      <div id="future-personal-notes" tabIndex={-1}>
+        <FuturePersonalNotes personal={personal} onSave={patch} />
+      </div>
+    </article>
+  );
+}
diff --git a/src/features/future/FutureEvidence.tsx b/src/features/future/FutureEvidence.tsx
new file mode 100644
index 0000000..1707bb2
--- /dev/null
+++ b/src/features/future/FutureEvidence.tsx
@@ -0,0 +1,39 @@
+import type { FuturePayload } from "./schema";
+export function FutureEvidence({
+  urls,
+  payload,
+}: {
+  urls: string[];
+  payload: FuturePayload;
+}) {
+  return urls.length ? (
+    <ul className="future-evidence">
+      {urls.map((url) => (
+        <li key={url}>
+          <a href={url} target="_blank" rel="noreferrer noopener">
+            {payload.provenance.sources.find((s) => s.url === url)?.label ||
+              "Source déclarée"}{" "}
+            <span aria-hidden="true">↗</span>
+          </a>
+        </li>
+      ))}
+    </ul>
+  ) : (
+    <p className="future-missing">
+      Aucune source renseignée pour cette affirmation.
+    </p>
+  );
+}
+export function FutureText({ text }: { text: string }) {
+  return text.length > 320 ? (
+    <>
+      <p>{text.slice(0, 320)}…</p>
+      <details>
+        <summary>Lire le texte complet</summary>
+        <p>{text}</p>
+      </details>
+    </>
+  ) : (
+    <p>{text}</p>
+  );
+}
diff --git a/src/features/future/FutureOverview.tsx b/src/features/future/FutureOverview.tsx
new file mode 100644
index 0000000..9e08d21
--- /dev/null
+++ b/src/features/future/FutureOverview.tsx
@@ -0,0 +1,69 @@
+import type { FuturePayload } from "./schema";
+import { contentCounts } from "./selectors";
+export type AtlasCounts = ReturnType<typeof contentCounts>;
+export function FutureSummary({ counts }: { counts: AtlasCounts }) {
+  return (
+    <div className="future-summary" aria-label="Résumé d’une minute">
+      <article>
+        <span className="future-kicker">01 / Faits observés</span>
+        <strong>{counts.observations}</strong>
+        <p>
+          Observations déclarées et sourcées. Aucune vérification indépendante
+          par Journal 360.
+        </p>
+      </article>
+      <article>
+        <span className="future-kicker">02 / Hypothèses à surveiller</span>
+        <strong>{counts.hypotheses}</strong>
+        <p>
+          Scénarios, jalons prospectifs et signaux à surveiller ; des
+          possibilités à éprouver.
+        </p>
+      </article>
+      <article>
+        <span className="future-kicker">03 / Actions concrètes</span>
+        <strong>{counts.actions}</strong>
+        <p>
+          Actions proposées par les dossiers. Votre suivi personnel reste privé
+          et local.
+        </p>
+      </article>
+    </div>
+  );
+}
+export function FutureOverview({ payload: p }: { payload: FuturePayload }) {
+  return (
+    <section
+      id="future-atlas-overview"
+      className="future-overview"
+      tabIndex={-1}
+    >
+      <div className="future-section-heading">
+        <span className="future-kicker">VUE D’ENSEMBLE</span>
+        <h2>L’essentiel, avant d’explorer.</h2>
+        <p>{p.editorialDecision.reason}</p>
+      </div>
+      <FutureSummary counts={contentCounts(p)} />
+      <ol className="future-essentials">
+        <li>
+          <b>Une trajectoire possible</b>
+          <p>{p.scenarios[0]?.summary || "Aucun scénario renseigné."}</p>
+        </li>
+        <li>
+          <b>Une objection à garder en tête</b>
+          <p>
+            {p.scenarios.flatMap((s) => s.objections)[0] || "Non renseigné."}
+          </p>
+        </li>
+        <li>
+          <b>Un premier pas concret</b>
+          <p>{p.actions[0]?.title || "Aucune action renseignée."}</p>
+        </li>
+      </ol>
+      <p className="future-disclaimer">
+        Les observations sont déclarées dans le dossier. Une hypothèse ou un
+        scénario n’est jamais une garantie.
+      </p>
+    </section>
+  );
+}
diff --git a/src/features/future/FuturePersonalNotes.tsx b/src/features/future/FuturePersonalNotes.tsx
new file mode 100644
index 0000000..8472a9b
--- /dev/null
+++ b/src/features/future/FuturePersonalNotes.tsx
@@ -0,0 +1,96 @@
+import { useState } from "react";
+import type { FuturePersonal } from "./schema";
+import type { SavePersonal } from "./FutureActions";
+import { now } from "../../data/model";
+import { formatDate } from "./selectors";
+export function FuturePersonalNotes({
+  personal,
+  onSave,
+}: {
+  personal: FuturePersonal;
+  onSave: SavePersonal;
+}) {
+  const [note, setNote] = useState(""),
+    [busy, setBusy] = useState(false);
+  return (
+    <section className="quiet-panel future-personal">
+      <span className="future-kicker">VOTRE CARNET PRIVÉ</span>
+      <h2>Mes notes et décisions privées</h2>
+      <form
+        onSubmit={async (e) => {
+          e.preventDefault();
+          const f = new FormData(e.currentTarget);
+          setBusy(true);
+          await onSave({
+            decision: String(f.get("decision")),
+            invalidation: String(f.get("invalidation")),
+            reviewDate: String(f.get("reviewDate")),
+          });
+          setBusy(false);
+        }}
+      >
+        <fieldset disabled={busy}>
+          <label>
+            Ma décision
+            <textarea
+              name="decision"
+              maxLength={4000}
+              defaultValue={personal.decision}
+            />
+          </label>
+          <label>
+            Ce qui invaliderait ma décision
+            <textarea
+              name="invalidation"
+              maxLength={4000}
+              defaultValue={personal.invalidation}
+            />
+          </label>
+          <label>
+            Date de réexamen
+            <input
+              name="reviewDate"
+              type="date"
+              defaultValue={personal.reviewDate}
+            />
+          </label>
+          <button className="secondary">Enregistrer ma décision</button>
+        </fieldset>
+      </form>
+      <form
+        onSubmit={async (e) => {
+          e.preventDefault();
+          if (!note.trim()) return;
+          setBusy(true);
+          const ok = await onSave({
+            notes: [{ id: crypto.randomUUID(), body: note.trim(), at: now() }],
+          });
+          if (ok) setNote("");
+          setBusy(false);
+        }}
+      >
+        <label>
+          Nouvelle note
+          <textarea
+            disabled={busy}
+            value={note}
+            maxLength={20000}
+            onChange={(e) => setNote(e.target.value)}
+            required
+          />
+        </label>
+        <button disabled={busy} className="primary">
+          Ajouter ma note
+        </button>
+      </form>
+      <ul>
+        {personal.notes.map((n) => (
+          <li key={n.id}>
+            <time>{formatDate(n.at)}</time>
+            <p>{n.body}</p>
+          </li>
+        ))}
+      </ul>
+    </section>
+  );
+}
diff --git a/src/features/future/FutureScenarioCompare.tsx b/src/features/future/FutureScenarioCompare.tsx
new file mode 100644
index 0000000..908168c
--- /dev/null
+++ b/src/features/future/FutureScenarioCompare.tsx
@@ -0,0 +1,124 @@
+import { useState } from "react";
+import { statusLabels, type FuturePayload } from "./schema";
+import { itemAnchor, pathLabels, scenarioEvidence } from "./selectors";
+import { FutureEvidence, FutureText } from "./FutureEvidence";
+export function FutureScenarioCompare({
+  payload: p,
+}: {
+  payload: FuturePayload;
+}) {
+  const [detailed, setDetailed] = useState(false);
+  function card(s: FuturePayload["scenarios"][number]) {
+    return (
+      <article
+        className="future-scenario quiet-panel"
+        key={s.id}
+        id={itemAnchor(s.id)}
+      >
+        <span className="future-badge">
+          {statusLabels[s.status]} ·{" "}
+          {s.horizon === "unspecified" ? "Horizon non précisé" : s.horizon}
+        </span>
+        <h3>{s.title}</h3>
+        <FutureText text={s.summary} />
+        <details open={detailed}>
+          <summary>Hypothèses et conditions</summary>
+          <h4>Hypothèses</h4>
+          <Items items={s.assumptions} />
+          <h4>Déclencheurs</h4>
+          <Items items={s.triggers} />
+          <h4>Indicateurs à suivre</h4>
+          <Items items={s.indicators} />
+          <h4>Implications</h4>
+          <p>Non renseigné dans un champ dédié ; voir le résumé du scénario.</p>
+        </details>
+        <details open={detailed}>
+          <summary>Voir les objections</summary>
+          <Items items={s.objections} />
+        </details>
+        <details open={detailed}>
+          <summary>Voir les sources</summary>
+          <p>
+            Références déclarées dans les jalons et signaux liés à ce scénario.
+          </p>
+          <FutureEvidence urls={scenarioEvidence(p, s.id)} payload={p} />
+        </details>
+        {s.signalIds.length > 0 && (
+          <div className="future-linked-signals">
+            <b>Signaux liés</b>
+            <ul>
+              {s.signalIds.map((id) => (
+                <li key={id}>
+                  {p.visualization.modules.includes("signals") ? (
+                    <a href={"#" + itemAnchor(id)}>
+                      {p.signals.find((v) => v.id === id)?.title}
+                    </a>
+                  ) : (
+                    p.signals.find((v) => v.id === id)?.title
+                  )}
+                </li>
+              ))}
+            </ul>
+          </div>
+        )}
+      </article>
+    );
+  }
+  return (
+    <>
+      <div className="future-section-heading">
+        <span className="future-kicker">02 / SCÉNARIOS</span>
+        <h2>Plusieurs futurs. Un regard critique.</h2>
+        <p>
+          Comparez les conditions et les objections, sans probabilité ni
+          classement inventé.
+        </p>
+        <button aria-pressed={detailed} onClick={() => setDetailed((v) => !v)}>
+          {detailed ? "Vue compacte" : "Vue détaillée"}
+        </button>
+      </div>
+      {!p.scenarios.length ? (
+        <p className="future-empty">
+          Aucun scénario fourni. Aucune trajectoire n’est inventée.
+        </p>
+      ) : (
+        <>
+          <div className="future-scenario-compare">
+            {(["acceleration", "moderate", "slowdown"] as const).map((path) => (
+              <section
+                className={"future-lane future-lane-" + path}
+                key={path}
+                aria-label={pathLabels[path]}
+              >
+                <h3 className="future-lane-title">{pathLabels[path]}</h3>
+                {p.scenarios.filter((s) => s.path === path).map(card)}
+                {!p.scenarios.some((s) => s.path === path) && (
+                  <p className="future-missing">Trajectoire non renseignée.</p>
+                )}
+              </section>
+            ))}
+          </div>
+          {p.scenarios.some((s) => s.path === "other") && (
+            <section className="future-other">
+              <h3>Autres trajectoires</h3>
+              <div className="future-grid">
+                {p.scenarios.filter((s) => s.path === "other").map(card)}
+              </div>
+            </section>
+          )}
+        </>
+      )}
+    </>
+  );
+}
+function Items({ items }: { items: string[] }) {
+  return items.length ? (
+    <ul>
+      {items.map((text, i) => (
+        <li key={i}>{text}</li>
+      ))}
+    </ul>
+  ) : (
+    <p className="future-missing">Non renseigné.</p>
+  );
+}
