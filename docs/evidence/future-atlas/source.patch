@@ -0,0 +1,102 @@
+import { describe, it, expect } from "vitest";
+import { readFileSync } from "node:fs";
+import { validateFuture } from "../src/features/future/import";
+import {
+  contentCounts,
+  timelineItems,
+  timelinePeriods,
+  periodFor,
+  preparationCounts,
+  scenarioEvidence,
+} from "../src/features/future/selectors";
+import { personalSchema } from "../src/features/future/schema";
+const fixture = () =>
+  validateFuture(
+    JSON.parse(
+      readFileSync("public/examples/future/EXEMPLE_FUTUR_IA_v1.json", "utf8"),
+    ),
+  );
+describe("Atlas: données fidèles sans mutation", () => {
+  it("préserve les textes, années, preuves et liens exacts des trois trajectoires", () => {
+    const p = fixture(),
+      before = JSON.stringify(p);
+    const items = timelineItems(p);
+    expect(items.map((m) => m.id).sort()).toEqual(
+      p.scenarios.flatMap((s) => s.milestones.map((m) => m.id)).sort(),
+    );
+    expect(items.every((m, i) => i === 0 || m.year >= items[i - 1].year)).toBe(
+      true,
+    );
+    expect(timelinePeriods(p)).toEqual(["2027", "2030", "2035", "2040+"]);
+    expect(contentCounts(p)).toEqual({
+      observations: 0,
+      hypotheses: 10,
+      actions: 3,
+    });
+    expect(scenarioEvidence(p, "scenario-moderate")).toEqual([
+      "https://example.org/illustration",
+    ]);
+    expect(JSON.stringify(p)).toBe(before);
+  });
+  it("gère zéro, un et de nombreux éléments, y compris les années hors des repères", () => {
+    const p = fixture();
+    p.scenarios = [];
+    p.signals = [];
+    p.actions = [];
+    p.visualization.links = [];
+    expect(contentCounts(p)).toEqual({
+      observations: 0,
+      hypotheses: 0,
+      actions: 0,
+    });
+    expect(timelineItems(p)).toEqual([]);
+    expect(timelinePeriods(p)).toEqual(["2027", "2030", "2035", "2040+"]);
+    p.scenarios = [fixture().scenarios[0]];
+    p.scenarios[0].signalIds = [];
+    p.scenarios[0].milestones = [
+      { ...p.scenarios[0].milestones[0], year: 2028 },
+    ];
+    expect(timelinePeriods(p)).toContain("2028");
+    p.scenarios[0].milestones = Array.from({ length: 100 }, (_, i) => ({
+      ...p.scenarios[0].milestones[0],
+      id: "many-" + i,
+      year: 2040 + (i % 61),
+    }));
+    expect(timelineItems(p)).toHaveLength(100);
+    expect(periodFor(2100)).toBe("2040+");
+    expect(contentCounts(p).hypotheses).toBe(101);
+  });
+  it("compte seulement les statuts personnels des actions encore présentes, sans compter les brouillons", () => {
+    const p = fixture(),
+      personal = personalSchema.parse({
+        documentId: p.documentId,
+        updatedAt: new Date().toISOString(),
+        actions: {
+          "action-now": { status: "done", result: "test" },
+          "action-3m": { status: "abandoned", result: "" },
+          "ancienne-action": { status: "done", result: "" },
+        },
+      });
+    expect(preparationCounts(p, personal)).toEqual({
+      todo: 1,
+      doing: 0,
+      done: 1,
+      abandoned: 1,
+    });
+  });
+  it("détecte les deux injections de données demandées, puis accepte le dossier conforme", () => {
+    const p = fixture();
+    p.scenarios[0].milestones[0].status = "observed";
+    p.scenarios[0].milestones[0].observedAt = "2026-10-16";
+    p.scenarios[0].milestones[0].evidenceUrls = [
+      "https://example.org/illustration",
+    ];
+    expect(() => validateFuture(p, new Date("2026-10-17T12:00:00Z"))).toThrow(
+      /jalon futur/,
+    );
+    const q = fixture();
+    q.signals[0].evidenceUrls = ["https://example.org/preuve-absente"];
+    expect(() => validateFuture(q)).toThrow(/provenance.sources/);
+    expect(() => validateFuture(fixture())).not.toThrow();
+  });
+});
diff --git a/scripts/measure-future-atlas.mjs b/scripts/measure-future-atlas.mjs
new file mode 100644
index 0000000..4f12b1b
--- /dev/null
+++ b/scripts/measure-future-atlas.mjs
@@ -0,0 +1,160 @@
+// Local-only, synthetic browser benchmark. Run against an already built preview.
+import { chromium } from "playwright";
+import { mkdir, writeFile } from "node:fs/promises";
+import { resolve } from "node:path";
+const [url, output] = process.argv.slice(2);
+if (!url || new URL(url).hostname !== "127.0.0.1" || !output)
+  throw Error(
+    "Usage: node scripts/measure-future-atlas.mjs http://127.0.0.1:PORT output-directory",
+  );
+await mkdir(output, { recursive: true });
+const browser = await chromium.launch({ headless: true });
+const results = [];
+try {
+  for (const width of [1440, 768, 390]) {
+    const context = await browser.newContext({
+      viewport: { width, height: 1000 },
+    });
+    const page = await context.newPage();
+    await page.route("**/*", (route) =>
+      new URL(route.request().url()).hostname === "127.0.0.1"
+        ? route.continue()
+        : route.abort(),
+    );
+    await page.addInitScript(() => {
+      window.__atlasMetrics = { cls: 0, lcp: null };
+      try {
+        new PerformanceObserver((list) => {
+          for (const e of list.getEntries())
+            if (!e.hadRecentInput) window.__atlasMetrics.cls += e.value;
+        }).observe({ type: "layout-shift", buffered: true });
+        new PerformanceObserver((list) => {
+          window.__atlasMetrics.lcp = list.getEntries().at(-1)?.startTime;
+        }).observe({ type: "largest-contentful-paint", buffered: true });
+      } catch {
+        /* browser support is reported */
+      }
+    });
+    await page.goto(url);
+    await page
+      .getByLabel("Fichiers HTML à importer")
+      .setInputFiles(
+        resolve("public/examples/future/EXEMPLE_FUTUR_IA_v1.json"),
+      );
+    await page.getByRole("button", { name: /Importer \d+ fichier/ }).click();
+    await page.locator(".future-title").waitFor();
+    const toast = page.getByRole("button", {
+      name: "Fermer la notification",
+      exact: true,
+    });
+    if (await toast.isVisible()) await toast.click();
+    const nav = async (name) => {
+      const surface = (await page.locator(".sidebar").isVisible())
+        ? ".sidebar"
+        : ".mobile-nav";
+      await page
+        .locator(surface)
+        .getByRole("button", { name, exact: true })
+        .click();
+    };
+    const cdp = await context.newCDPSession(page);
+    await cdp.send("Performance.enable");
+    const getCPU = async () =>
+      (await cdp.send("Performance.getMetrics")).metrics.find(
+        (m) => m.name === "TaskDuration",
+      )?.value;
+    const entryMs = [],
+      detailMs = [];
+    const cpuStart = await getCPU();
+    for (let i = 0; i < 5; i++) {
+      await nav("Bibliothèque");
+      const start = performance.now();
+      await nav("Le Futur");
+      await page.locator(".future-title").waitFor();
+      entryMs.push(performance.now() - start);
+      const detailStart = performance.now();
+      await page.locator(".future-title").click();
+      await page.locator(".future-detail h2").first().waitFor();
+      detailMs.push(performance.now() - detailStart);
+      await page.getByRole("button", { name: "← Tous les dossiers" }).click();
+    }
+    await page.screenshot({
+      path: output + "/home-" + width + ".png",
+      fullPage: true,
+    });
+    await page.locator(".future-title").click();
+    await page.locator(".future-detail h2").first().waitFor();
+    await page.screenshot({
+      path: output + "/detail-" + width + ".png",
+      fullPage: true,
+    });
+    const scroll = await page.evaluate(
+      () =>
+        new Promise((resolve) => {
+          const samples = [];
+          let previous, started;
+          const initialY = window.scrollY;
+          const tick = (at) => {
+            if (previous !== undefined) {
+              samples.push(at - previous);
+              window.scrollBy(0, 110);
+            } else started = at;
+            previous = at;
+            if (samples.length === 40) {
+              const distancePx = window.scrollY - initialY;
+              window.scrollTo(0, 0);
+              resolve({
+                frames: samples,
+                distancePx,
+                durationMs: at - started,
+              });
+            } else requestAnimationFrame(tick);
+          };
+          requestAnimationFrame(tick);
+        }),
+    );
+    const metrics = await page.evaluate(() => ({
+      paint: window.__atlasMetrics,
+      heap: performance.memory?.usedJSHeapSize ?? null,
+      resources: performance
+        .getEntriesByType("resource")
+        .filter((r) => /\.(js|css)(\?|$)/.test(r.name))
+        .map((r) => ({
+          name: new URL(r.name).pathname,
+          transferSize: r.transferSize,
+          decodedBodySize: r.decodedBodySize,
+        })),
+      overflow: document.documentElement.scrollWidth > innerWidth,
+    }));
+    results.push({
+      width,
+      entryMs,
+      detailMs,
+      taskDurationSeconds: (await getCPU()) - cpuStart,
+      heapUsedBytes:
+        (await cdp.send("Performance.getMetrics")).metrics.find(
+          (m) => m.name === "JSHeapUsedSize",
+        )?.value ?? null,
+      scrollFramesMs: scroll.frames,
+      scrollDistancePx: scroll.distancePx,
+      scrollDurationMs: scroll.durationMs,
+      scrollPixelsPerSecond: (scroll.distancePx / scroll.durationMs) * 1000,
+      ...metrics,
+    });
+    await context.close();
+  }
+  await writeFile(
+    output + "/browser-performance.json",
+    JSON.stringify(
+      {
+        environment:
+          "Chromium headless, synthetic example, 5 warm navigations, 40 scripted scroll frames; not a phone or user study. LCP/CLS describe initial shell, not the SPA tab. Heap includes browser context, not screen-only memory.",
+        results,
+      },
+      null,
+      2,
+    ) + "\n",
+  );
+} finally {
+  await browser.close();
+}
diff --git a/scripts/compare-future-atlas-tabs.mjs b/scripts/compare-future-atlas-tabs.mjs
new file mode 100644
index 0000000..3cf6d1e
--- /dev/null
+++ b/scripts/compare-future-atlas-tabs.mjs
@@ -0,0 +1,82 @@
+import { chromium } from "playwright";
+import { mkdir, writeFile } from "node:fs/promises";
+import { createHash } from "node:crypto";
+const [beforeURL, afterURL, output] = process.argv.slice(2);
+if (
+  !output ||
+  [beforeURL, afterURL].some((u) => new URL(u).hostname !== "127.0.0.1")
+)
+  throw Error("Local preview URLs and output directory required");
+const browser = await chromium.launch({ headless: true });
+const results = [];
+try {
+  for (const width of [1440, 390]) {
+    const images = new Map();
+    for (const [phase, url] of [
+      ["before", beforeURL],
+      ["after", afterURL],
+    ]) {
+      const context = await browser.newContext({
+        viewport: { width, height: 1000 },
+      });
+      const page = await context.newPage();
+      await page.route("**/*", (r) =>
+        new URL(r.request().url()).hostname === "127.0.0.1"
+          ? r.continue()
+          : r.abort(),
+      );
+      await page.goto(url);
+      const area = width > 700 ? ".sidebar" : ".mobile-nav";
+      await page
+        .locator(area)
+        .getByRole("button", { name: "Le Futur", exact: true })
+        .click();
+      await page.locator(".future-workspace").waitFor();
+      await mkdir(output + "/" + phase, { recursive: true });
+      for (const [key, name] of [
+        ["library", "Bibliothèque"],
+        ["articles", "Articles"],
+        ["major-ai", "IA majeur"],
+        ["sentinel", "Sentinel"],
+      ]) {
+        await page
+          .locator(area)
+          .getByRole("button", { name, exact: true })
+          .click();
+        await page.locator(".future-workspace").waitFor({ state: "detached" });
+        const bytes = await page.screenshot({
+          path: output + "/" + phase + "/" + key + "-" + width + ".png",
+          fullPage: true,
+          animations: "disabled",
+        });
+        const hash = createHash("sha256").update(bytes).digest("hex");
+        if (phase === "before") images.set(key, hash);
+        else
+          results.push({
+            width,
+            tab: name,
+            identicalPNG: images.get(key) === hash,
+            beforeSHA256: images.get(key),
+            afterSHA256: hash,
+          });
+      }
+      await context.close();
+    }
+  }
+  await writeFile(
+    output + "/comparison.json",
+    JSON.stringify(
+      {
+        scope:
+          "Empty stable views, feature CSS already loaded; same Chromium/viewport. Functional populated views covered by full E2E.",
+        results,
+      },
+      null,
+      2,
+    ) + "\n",
+  );
+  if (results.some((r) => !r.identicalPNG))
+    throw Error("Visual difference found; inspect before/after PNGs");
+} finally {
+  await browser.close();
+}
