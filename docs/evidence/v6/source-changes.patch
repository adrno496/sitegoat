+  const current = day.current;
+  if (!current) return null;
+  const currentAssessment = day.versions.find(
+    (v) => v.edition.id === current.id,
+  )!.assessment;
+  return (
+    <article className="edition-card day-card">
+      <p className="eyebrow">JOURNÉE · {dateLabel(current.date)}</p>
+      <h3>{current.title}</h3>
+      <p>
+        {current.articles.filter((a) => a.kind === "news").length} actualités
+        explicitement typées · {current.articles.length} éléments indexés ·{" "}
+        {versions.length} version(s) conservée(s)
+      </p>
+      <p className={`day-status ${day.status !== "COMPLETE" ? "warning" : ""}`}>
+        CUMUL{" "}
+        {day.status === "COMPLETE"
+          ? "COMPLETE"
+          : day.status === "PARTIAL"
+            ? "PARTIAL"
+            : "UNKNOWN"}
+      </p>
+      <div className="day-slots">
+        {SLOTS.map((slot) => (
+          <span
+            key={slot}
+            className={current.slotsIncluded?.includes(slot) ? "included" : ""}
+          >
+            {slot}{" "}
+            {current.slotsIncluded?.includes(slot)
+              ? "inclus déclaré"
+              : "non inclus"}
+          </span>
+        ))}
+      </div>
+      <p className="small-note">
+        {day.reliable
+          ? "Dernière version fiable selon les contrôles disponibles"
+          : "Cumul non vérifié : consultez l’historique"}{" "}
+        · révision externe {current.externalRevision ?? "inconnue"}
+      </p>
+      {day.versions.some((v) => v.assessment.issues.length) && (
+        <p className="warning">
+          Conflit ou version partielle dans l’historique.
+        </p>
+      )}
+      {!!currentAssessment.missingSlots.length && (
+        <p className="warning">
+          Trous : {currentAssessment.missingSlots.join(" / ")}
+        </p>
+      )}
+      <div className="settings-actions">
+        <button
+          className="primary"
+          onClick={() => onOpen(current.id)}
+          aria-label={`Lire ${current.title}`}
+        >
+          Lire la version courante
+        </button>
+        <button
+          className="secondary"
+          onClick={() => onHistory(current.dayKey!)}
+        >
+          Historique des éditions
+        </button>
+      </div>
+    </article>
+  );
+}
+export function DayView({
+  versions,
+  notes,
+  onBack,
+  onOpen,
+}: {
+  versions: Edition[];
+  notes: Note[];
+  onBack: () => void;
+  onOpen: (id: string) => void;
+}) {
+  const day = useMemo(() => resolveDay(versions), [versions]);
+  const [selectedId, setSelectedId] = useState(day.current?.id || "");
+  const [query, setQuery] = useState("");
+  const [category, setCategory] = useState("all");
+  const selected = versions.find((e) => e.id === selectedId) || day.current;
+  if (!selected)
+    return (
+      <section>
+        <h1>Journée indisponible</h1>
+        <button onClick={onBack}>Bibliothèque</button>
+      </section>
+    );
+  const assessment = day.versions.find(
+    (v) => v.edition.id === selected.id,
+  )!.assessment;
+  const categories = [...new Set(selected.articles.map((a) => a.category))];
+  const articles = selected.articles.filter(
+    (a) =>
+      (category === "all" || a.category === category) &&
+      `${a.title} ${a.text}`
+        .toLocaleLowerCase("fr")
+        .includes(query.toLocaleLowerCase("fr")),
+  );
+  const privateNotes = notes.filter((n) =>
+    versions.some((e) => e.id === n.editionId),
+  );
+  return (
+    <section className="day-view">
+      <button className="text-button" onClick={onBack}>
+        Retour à la bibliothèque
+      </button>
+      <p className="eyebrow">JOURNAL 360° · JOURNÉE PRIVÉE</p>
+      <h1>Journée du {dateLabel(selected.date)}</h1>
+      <p>
+        {versions.length} versions · {assessment.status} · {selected.dayKey}
+      </p>
+      <div className="day-slots">
+        {SLOTS.map((slot) => (
+          <span key={slot}>
+            {slot} :{" "}
+            {selected.slotsIncluded?.includes(slot)
+              ? "inclus déclaré"
+              : "non inclus"}
+          </span>
+        ))}
+      </div>
+      <p className="small-note">
+        Les créneaux sont déclarés par le fichier. Le contrôle compare les
+        événements des versions reçues ; il ne certifie pas les actualités.
+      </p>
+      <div className="settings-actions">
+        <button className="primary" onClick={() => onOpen(selected.id)}>
+          Lire cette version
+        </button>
+        {day.reliable && (
+          <button
+            className="secondary"
+            onClick={() => {
+              setSelectedId(day.reliable!.id);
+              onOpen(day.reliable!.id);
+            }}
+          >
+            Dernière version fiable
+          </button>
+        )}
+      </div>
+      <h2>Historique des éditions</h2>
+      <div className="day-history">
+        {day.versions.map(({ edition, assessment: result }) => (
+          <article className="quiet-panel" key={edition.id}>
+            <h3>
+              Révision externe {edition.externalRevision ?? "inconnue"} ·
+              version locale {edition.revision}
+            </h3>
+            <p>
+              {result.status} · {edition.articles.length} éléments indexés ·{" "}
+              {sizeLabel(edition.size)}
+              {edition.deleted
+                ? " · Corbeille"
+                : edition.archived
+                  ? " · Archive"
+                  : ""}
+            </p>
+            <p>
+              {result.newEvents} nouveaux événements identifiés ·{" "}
+              {result.corrections} corrections textuelles ·{" "}
+              {result.removedEvents} absences
+            </p>
+            {result.issues.map((issue) => (
+              <p className="warning" key={issue}>
+                {issue}
+              </p>
+            ))}
+            <p className="small-note">
+              Import {verifiedLabel(edition.importedAt)}
+              {edition.sourceVerifiedAt
+                ? ` · Vérification déclarée ${verifiedLabel(edition.sourceVerifiedAt)}`
+                : ""}
+            </p>
+            <details>
+              <summary>Empreinte de l’original</summary>
+              <code className="hash-text">{edition.sha256}</code>
+            </details>
+            <button
+              className="secondary"
+              aria-pressed={selected.id === edition.id}
+              onClick={() => {
+                setSelectedId(edition.id);
+                setCategory("all");
+              }}
+            >
+              Consulter la révision{" "}
+              {edition.externalRevision ?? edition.revision}
+            </button>
+          </article>
+        ))}
+      </div>
+      <h2>Articles de la version sélectionnée</h2>
+      <div className="filters">
+        <label>
+          Rechercher dans la journée
+          <input value={query} onChange={(e) => setQuery(e.target.value)} />
+        </label>
+        <label>
+          Rubrique du jour
+          <select
+            value={category}
+            onChange={(e) => setCategory(e.target.value)}
+          >
+            <option value="all">Toutes les rubriques</option>
+            {categories.map((c) => (
+              <option key={c}>{c}</option>
+            ))}
+          </select>
+        </label>
+      </div>
+      <p>
+        {articles.length} résultat(s). Aucun article n’a été ajouté par le
+        lecteur.
+      </p>
+      {articles.map((article) => (
+        <article className="quiet-panel" key={article.id}>
+          <p className="eyebrow">
+            {article.category} · {article.kind || "nature non précisée"}
+            {article.firstSeenSlot
+              ? ` · première apparition déclarée ${article.firstSeenSlot}`
+              : ""}
+          </p>
+          <h3>{article.title}</h3>
+          <p className="article-text">{article.text}</p>
+          <ul className="sources">
+            {article.sources
+              .map(validateSourceUrl)
+              .filter((u): u is string => !!u)
+              .map((u) => (
+                <li key={u}>
+                  <a href={u} target="_blank" rel="noopener noreferrer">
+                    Source originale : {u}
+                  </a>
+                </li>
+              ))}
+          </ul>
+        </article>
+      ))}
+      <h2>Notes privées de cette journée</h2>
+      <p>
+        Les notes restent liées à leur version d’origine. Elles ne sont jamais
+        jointes aux demandes Google.
+      </p>
+      {privateNotes.map((note) => (
+        <article className="quiet-panel" key={note.id}>
+          <p>{note.body}</p>
+          <button
+            className="text-button"
+            onClick={() => onOpen(note.editionId)}
+          >
+            Ouvrir la version annotée
+          </button>
+        </article>
+      ))}
+    </section>
+  );
+}
diff --git a/src/features/GoogleAiDialog.tsx b/src/features/GoogleAiDialog.tsx
new file mode 100644
index 0000000..7249b6b
--- /dev/null
+++ b/src/features/GoogleAiDialog.tsx
@@ -0,0 +1,163 @@
+import { useRef, useState } from "react";
+import {
+  GOOGLE_AI_ENTRY,
+  validPublicQuestion,
+  validateGoogleAiUrl,
+  type GoogleAiDestination,
+} from "./googleAi";
+export function GoogleAiDialog({
+  destination,
+  isCurrent,
+  onDismiss,
+}: {
+  destination: GoogleAiDestination;
+  isCurrent: () => boolean;
+  onDismiss: () => void;
+}) {
+  const [draft, setDraft] = useState(destination.query);
+  const [editing, setEditing] = useState(!!destination.entryOnly);
+  const [notice, setNotice] = useState("");
+  const [fallback, setFallback] = useState(false);
+  const entrySent = useRef(false);
+  const valid = validPublicQuestion(draft);
+  function open(entry: boolean) {
+    if (entry && entrySent.current) return;
+    if (!isCurrent()) {
+      onDismiss();
+      return;
+    }
+    if (!navigator.onLine) {
+      setNotice(
+        "Hors ligne : copiez la question et ouvrez Google après reconnexion.",
+      );
+      return;
+    }
+    let url = GOOGLE_AI_ENTRY;
+    if (!entry) {
+      if (editing && !valid) return;
+      if (editing) {
+        const candidate = new URL(destination.url);
+        candidate.searchParams.set("q", draft);
+        const checked = validateGoogleAiUrl(candidate.href);
+        if (!checked) return;
+        url = checked.url;
+      } else url = destination.url;
+    }
+    if (entry) entrySent.current = true;
+    try {
+      // Synchronous user gesture. noopener may return null even on success;
+      // do not invent a successful popup or incorrectly report one as blocked.
+      window.open(url, "_blank", "noopener,noreferrer");
+      if (!entry) onDismiss();
+      else {
+        setFallback(true);
+        setNotice(
+          "Ouverture demandée. Si aucun onglet n’apparaît, utilisez le lien direct ci-dessous. Collez ensuite la question dans Google.",
+        );
+      }
+    } catch {
+      setFallback(true);
+      setNotice("Ouverture indisponible : utilisez le lien direct ci-dessous.");
+    }
+  }
+  async function copy() {
+    if (!isCurrent() || !valid) return;
+    try {
+      if (!navigator.clipboard?.writeText)
+        throw new Error("Clipboard unavailable");
+      await navigator.clipboard.writeText(draft);
+      if (isCurrent())
+        setNotice("Question copiée. Aucune recherche n’a été lancée.");
+    } catch {
+      if (isCurrent()) {
+        setEditing(true);
+        setNotice(
+          "Copie indisponible. Sélectionnez la question et utilisez la copie de votre appareil.",
+        );
+      }
+    }
+  }
+  return (
+    <div className="modal-backdrop">
+      <section
+        role="dialog"
+        aria-modal="true"
+        aria-labelledby="google-ai-title"
+        aria-describedby="google-ai-warning"
+        className="modal compact google-ai-dialog"
+      >
+        <h2 id="google-ai-title">
+          Ouvrir Google Mode IA dans votre navigateur ?
+        </h2>
+        <p id="google-ai-warning">
+          {destination.entryOnly
+            ? "Vérifiez cette question : le fichier ne garantit pas qu’elle est publique. Seul le texte que vous copiez puis collez sera transmis à Google."
+            : "Le texte de la question sera transmis à Google."}
+        </p>
+        <p className="eyebrow">QUESTION À TRANSMETTRE</p>
+        {editing ? (
+          <label>
+            Question publique à vérifier
+            <textarea
+              className="google-ai-query"
+              value={draft}
+              maxLength={2000}
+              onChange={(e) => setDraft(e.target.value)}
+              rows={4}
+            />
+          </label>
+        ) : (
+          <p className="google-ai-query">{draft}</p>
+        )}
+        {!destination.entryOnly && (
+          <p className="small-note">
+            Le lien prérempli udm=50 dépend de Google ; son fonctionnement n’est
+            pas garanti. Vous pouvez aussi copier la question puis ouvrir
+            l’entrée officielle.
+          </p>
+        )}
+        {notice && <p role="status">{notice}</p>}
+        <div className="modal-actions">
+          <button className="secondary" onClick={onDismiss}>
+            Annuler
+          </button>
+          {!destination.entryOnly && (
+            <button
+              className="primary"
+              onClick={() => open(false)}
+              disabled={editing && !valid}
+            >
+              Ouvrir
+            </button>
+          )}
+          <button
+            className="secondary"
+            disabled={!valid}
+            onClick={() => void copy()}
+          >
+            Copier la question
+          </button>
+          {!editing && (
+            <button className="secondary" onClick={() => setEditing(true)}>
+              Modifier la question
+            </button>
+          )}
+          <button
+            className="primary"
+            disabled={entrySent.current}
+            onClick={() => open(true)}
+          >
+            Ouvrir Google Mode IA
+          </button>
+        </div>
+        {fallback && (
+          <p>
+            <a href={GOOGLE_AI_ENTRY} target="_blank" rel="noopener noreferrer">
+              Ouvrir directement Google Mode IA
+            </a>
+          </p>
+        )}
+      </section>
+    </div>
+  );
+}
