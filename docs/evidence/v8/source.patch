+      files: rows.length,
+      protectedUnchanged: protectedRows.length,
+      reversePatchCheck: "PASS",
+      actualIndex: "untouched",
+      reference: ref,
+    }),
+  );
+} finally {
+  rmSync(folder, { recursive: true, force: true });
+}
