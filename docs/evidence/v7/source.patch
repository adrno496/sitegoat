+);
+const browser = await chromium.launch();
+try {
+  const context = await browser.newContext({
+      viewport: { width: 1440, height: 1000 },
+    }),
+    page = await context.newPage();
+  let external = 0;
+  await page.route("**/*", (route) => {
+    if (new URL(route.request().url()).hostname !== "127.0.0.1") {
+      external++;
+      return route.abort();
+    }
+    return route.continue();
+  });
+  await page.goto(url);
+  await page
+    .locator(".sidebar")
+    .getByRole("button", { name: "Le Futur", exact: true })
+    .click();
+  const start = performance.now();
+  for (let batch = 0; batch < 10; batch++) {
+    await page.getByLabel("Fichiers HTML à importer").setInputFiles(
+      Array.from({ length: 20 }, (_, j) => {
+        const i = batch * 20 + j;
+        return {
+          name: `index-${i}.json`,
+          mimeType: "application/json",
+          buffer: Buffer.from(
+            JSON.stringify({
+              ...template,
+              documentId: `index-benchmark-${i}`,
+              title: `Index synthétique 200 dossier ${i}`,
+            }),
+          ),
+        };
+      }),
+    );
+    await page.getByRole("button", { name: /Importer \d+ fichier/ }).click();
+    await page.getByRole("dialog").waitFor({ state: "hidden" });
+  }
+  const importMs = performance.now() - start;
+  await page
+    .locator(".sidebar")
+    .getByRole("button", { name: "Aujourd’hui", exact: true })
+    .click();
+  const w = page.locator(".unified-workspace");
+  await w
+    .getByRole("button", { name: "Recherche globale", exact: true })
+    .waitFor();
+  const cdp = await context.newCDPSession(page);
+  await cdp.send("Performance.enable");
+  await cdp.send("HeapProfiler.collectGarbage");
+  const get = async (name) =>
+    (await cdp.send("Performance.getMetrics")).metrics.find(
+      (m) => m.name === name,
+    )?.value;
+  const heapBefore = await get("JSHeapUsedSize"),
+    cpuBefore = await get("TaskDuration"),
+    indexStart = performance.now();
+  await w
+    .getByRole("button", { name: "Recherche globale", exact: true })
+    .click();
+  await w.getByRole("status").filter({ hasText: "200 résultat(s)" }).waitFor();
+  const indexEntryMs = performance.now() - indexStart;
+  const searchStart = performance.now();
+  await w
+    .getByLabel("Rechercher partout")
+    .fill("INDEX SYNTHETIQUE 200 dossier 42");
+  await w.locator(".unified-result").first().waitFor();
+  const searchMs = performance.now() - searchStart;
+  await cdp.send("HeapProfiler.collectGarbage");
+  const result = {
+    environment:
+      "Desktop Chromium. 200 real UI imports of synthetic Future v1 JSON in a disposable browser context; no physical phone. Heap checkpoints after forced GC. No private data.",
+    documents: 200,
+    importMs,
+    indexEntryMs,
+    searchMs,
+    visibleMatches: await w.locator(".unified-result").count(),
+    heapBeforeIndexBytes: heapBefore,
+    heapAfterIndexBytes: await get("JSHeapUsedSize"),
+    indexAndSearchTaskSeconds: (await get("TaskDuration")) - cpuBefore,
+    externalRequests: external,
+  };
+  if (external) throw Error("Requête externe détectée");
+  await writeFile(output, JSON.stringify(result, null, 2) + "\n");
+  console.log(result);
+  await context.close();
+} finally {
+  await browser.close();
+}
diff --git a/scripts/package-v7-evidence.mjs b/scripts/package-v7-evidence.mjs
new file mode 100644
index 0000000..af0a9f6
--- /dev/null
+++ b/scripts/package-v7-evidence.mjs
@@ -0,0 +1,77 @@
+import { execFileSync } from "node:child_process";
+import { readFileSync, writeFileSync, mkdtempSync, rmSync } from "node:fs";
+import { createHash } from "node:crypto";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+const git = (args) => execFileSync("git", args, { encoding: "utf8" }),
+  sha = (bytes) => createHash("sha256").update(bytes).digest("hex");
+const names = [
+  ...new Set(
+    [
+      ...git(["diff", "--name-only", "HEAD"]).split("\n"),
+      ...git(["ls-files", "--others", "--exclude-standard"]).split("\n"),
+    ].filter((p) =>
+      /^(?:src\/|tests\/|scripts\/[^/]*unified|scripts\/check-v7|scripts\/package-v7|public\/examples\/unified\/|playwright\.config\.ts$|README\.md$|docs\/(?:JOURNAL360_V7_IMPORT_GUIDE\.md|JOURNAL360_UNIFIED_V7\.schema\.json)$)/.test(
+        p,
+      ),
+    ),
+  ),
+].sort();
+const rows = names.map((file) => ({ file, sha256: sha(readFileSync(file)) }));
+writeFileSync(
+  "docs/evidence/v7/source-files.json",
+  JSON.stringify(rows, null, 2) + "\n",
+);
+const protectedRows = JSON.parse(
+  readFileSync("docs/evidence/v7/protected.json", "utf8"),
+);
+for (const file of [
+  "src/styles.css",
+  "src/features/future/FutureTimeline.tsx",
+  "src/features/future/FutureScenarioCompare.tsx",
+  "src/features/future/FutureSignals.tsx",
+  "src/features/future/FutureActions.tsx",
+])
+  if (!protectedRows.some((r) => r.file === file))
+    protectedRows.push({
+      file,
+      sha256: sha(execFileSync("git", ["show", "43f8b56:" + file])),
+    });
+const protectedCheck = protectedRows.map((r) => ({
+  ...r,
+  unchanged: sha(readFileSync(r.file)) === r.sha256,
+}));
+writeFileSync(
+  "docs/evidence/v7/protected-final.json",
+  JSON.stringify(protectedCheck, null, 2) + "\n",
+);
+if (protectedCheck.some((r) => !r.unchanged))
+  throw Error("Source protégée modifiée.");
+const folder = mkdtempSync(join(tmpdir(), "j360-v7-index-"));
+try {
+  const env = { ...process.env, GIT_INDEX_FILE: join(folder, "index") };
+  execFileSync("git", ["read-tree", "HEAD"], { env });
+  execFileSync("git", ["add", "--", ...names], { env });
+  const patch = execFileSync(
+    "git",
+    ["diff", "--cached", "--binary", "HEAD", "--", ...names],
+    { env, maxBuffer: 20000000 },
+  );
+  writeFileSync("docs/evidence/v7/source.patch", patch);
+  execFileSync("git", [
+    "apply",
+    "--check",
+    "--reverse",
+    "docs/evidence/v7/source.patch",
+  ]);
+  console.log(
+    JSON.stringify({
+      files: rows.length,
+      protectedUnchanged: protectedCheck.length,
+      reversePatchCheck: "PASS",
+      actualIndex: "untouched",
+    }),
+  );
+} finally {
+  rmSync(folder, { recursive: true, force: true });
+}
