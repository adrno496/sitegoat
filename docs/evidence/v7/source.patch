diff --git a/src/features/unified/EconomyRadar.tsx b/src/features/unified/EconomyRadar.tsx
new file mode 100644
index 0000000..e857aab
--- /dev/null
+++ b/src/features/unified/EconomyRadar.tsx
@@ -0,0 +1,191 @@
+import { useState } from "react";
+import type { Edition } from "../../data/model";
+import {
+  economicRows,
+  economyFreshness,
+  economicDelta,
+  zoneLabels,
+  economicLabels,
+} from "./selectors";
+export function EconomyRadar({
+  editions,
+  compact = false,
+}: {
+  editions: Edition[];
+  compact?: boolean;
+}) {
+  const [zone, setZone] = useState(""),
+    [period, setPeriod] = useState(""),
+    [indicator, setIndicator] = useState("");
+  const rows = economicRows(editions),
+    filtered = rows.filter(
+      (r) =>
+        (!zone || r.data.zone === zone) &&
+        (!period || r.data.period === period) &&
+        (!indicator || r.data.indicator === indicator),
+    );
+  return (
+    <section
+      aria-labelledby={compact ? "economy-preview-title" : "economy-title"}
+    >
+      <p className="eyebrow">LES CHIFFRES, LEUR DATE, LEURS LIMITES</p>
+      <h2 id={compact ? "economy-preview-title" : "economy-title"}>
+        Radar économique mondial
+      </h2>
+      <p>
+        France, Europe, États-Unis, Chine. Les statuts sont déclarés par les
+        sources importées ; aucune certification ni recommandation financière
+        personnelle.
+      </p>
+      {!compact && (
+        <div className="unified-filters">
+          <label>
+            Zone économique
+            <select value={zone} onChange={(e) => setZone(e.target.value)}>
+              <option value="">Toutes les zones</option>
+              {Object.entries(zoneLabels).map(([k, v]) => (
+                <option value={k} key={k}>
+                  {v}
+                </option>
+              ))}
+            </select>
+          </label>
+          <label>
+            Période statistique
+            <select value={period} onChange={(e) => setPeriod(e.target.value)}>
+              <option value="">Toutes les périodes</option>
+              {[...new Set(rows.map((r) => r.data.period))].map((v) => (
+                <option key={v}>{v}</option>
+              ))}
+            </select>
+          </label>
+          <label>
+            Indicateur économique
+            <select
+              value={indicator}
+              onChange={(e) => setIndicator(e.target.value)}
+            >
+              <option value="">Tous les indicateurs</option>
+              {[...new Set(rows.map((r) => r.data.indicator))].map((v) => (
+                <option key={v}>{v}</option>
+              ))}
+            </select>
+          </label>
+        </div>
+      )}
+      <div className="unified-zones">
+        {Object.entries(zoneLabels)
+          .filter(([k]) => !zone || zone === k)
+          .map(([key, label]) => {
+            const zoneRows = filtered.filter((r) => r.data.zone === key);
+            return (
+              <article className="unified-panel" key={key}>
+                <h3>{label}</h3>
+                {zoneRows.length ? (
+                  zoneRows
+                    .slice(0, compact ? 1 : 20)
+                    .map(({ data: e, edition }) => {
+                      const delta = economicDelta(e),
+                        stale = economyFreshness(e);
+                      return (
+                        <div
+                          className="economic-reading"
+                          key={JSON.stringify([e.id, e.period, e.publishedAt])}
+                        >
+                          {edition.unified?.synthetic && (
+                            <strong className="unified-badge">
+                              SYNTHÉTIQUE · chiffres fictifs
+                            </strong>
+                          )}
+                          <p className="unified-badge">
+                            {stale.startsWith("Donnée ancienne") ||
+                            !e.verifiedAt
+                              ? "Indéterminé"
+                              : economicLabels[e.status]}
+                          </p>
+                          <h4>{e.indicator}</h4>
+                          <p className="economic-value">
+                            {new Intl.NumberFormat("fr-FR", {
+                              maximumFractionDigits: 4,
+                            }).format(e.value)}{" "}
+                            <small>{e.unit}</small>
+                          </p>
+                          <dl>
+                            <dt>Dernière statistique</dt>
+                            <dd>
+                              {e.statisticDate} · période {e.period} ·{" "}
+                              {e.frequency}
+                            </dd>
+                            <dt>Situation / raison</dt>
+                            <dd>{e.reading || "Non renseignée"}</dd>
+                            <dt>Variation comparable</dt>
+                            <dd>
+                              {delta === null
+                                ? "Non disponible"
+                                : `${delta > 0 ? "+" : ""}${new Intl.NumberFormat("fr-FR").format(delta)} ${e.unit} depuis ${e.comparison!.period}`}
+                            </dd>
+                            <dt>Risque / contre-argument</dt>
+                            <dd>
+                              {e.risk || "Non renseigné"} ·{" "}
+                              {e.counterArgument || "Non renseigné"}
+                            </dd>
+                            <dt>État de la donnée</dt>
+                            <dd>
+                              {stale} · publication {e.publishedAt} · contrôle{" "}
+                              {e.verifiedAt || "absent"}
+                            </dd>
+                          </dl>
+                          <details>
+                            <summary>
+                              Source, définition et décision générale
+                            </summary>
+                            <p>
+                              {e.provider} · série {e.seriesCode} ·{" "}
+                              {e.definition}
+                            </p>
+                            {e.sourceRecords.map((s) => (
+                              <p key={s.id}>
+                                <a
+                                  href={s.url}
+                                  target="_blank"
+                                  rel="noopener noreferrer"
+                                >
+                                  {s.label}
+                                </a>{" "}
+                                · {s.publishedAt}
+                              </p>
+                            ))}
+                            <p>
+                              Pour moi :{" "}
+                              {edition.unified?.synthetic
+                                ? "indéterminé (données fictives)"
+                                : e.personalAction ||
+                                  "aucune action établie"}{" "}
+                              · {e.personalReason}
+                            </p>
+                          </details>
+                        </div>
+                      );
+                    })
+                ) : (
+                  <>
+                    <p className="unified-badge">Indéterminé</p>
+                    <p>
+                      Aucune statistique importée pour cette zone et ces
+                      filtres. Source, tendance et risque non établis.
+                    </p>
+                  </>
+                )}
+                {zoneRows.length > (compact ? 1 : 20) && (
+                  <p>
+                    {zoneRows.length - (compact ? 1 : 20)} publication(s)
+                    supplémentaire(s) : affinez les filtres.
+                  </p>
+                )}
+              </article>
+            );
+          })}
+      </div>
+    </section>
+  );
+}
diff --git a/src/features/unified/FutureBridge.tsx b/src/features/unified/FutureBridge.tsx
new file mode 100644
index 0000000..456e2ce
--- /dev/null
+++ b/src/features/unified/FutureBridge.tsx
@@ -0,0 +1,206 @@
+import { useState } from "react";
+import type { Edition } from "../../data/model";
+import { futureDb, type FutureDocument } from "../future/db";
+import { useLive } from "../future/hooks";
+import { statusLabels } from "../future/schema";
+import { validateFuture } from "../future/import";
+import { download } from "../backup";
+import { latestUnified } from "./selectors";
+export function useFutureCatalog() {
+  return useLive(
+    () => futureDb.documents.orderBy("updatedAt").reverse().toArray(),
+    [],
+    null as FutureDocument[] | null,
+  );
+}
+export function FutureBridge({
+  editions,
+  onFuture,
+  catalog,
+  compact = false,
+}: {
+  editions: Edition[];
+  onFuture: (id?: string) => void;
+  catalog: ReturnType<typeof useFutureCatalog>;
+  compact?: boolean;
+}) {
+  const [kind, setKind] = useState("all"),
+    [horizon, setHorizon] = useState(""),
+    [error, setError] = useState("");
+  const docs = catalog.value || [],
+    loadError = catalog.error;
+  const insights = latestUnified(editions)
+    .flatMap((e) =>
+      e.unified!.futureInsights.map((i) => ({
+        ...i,
+        synthetic: e.unified!.synthetic,
+      })),
+    )
+    .filter((i, index, all) => all.findIndex((x) => x.id === i.id) === index);
+  const rows = insights.filter(
+    (i) =>
+      (kind === "all" ||
+        (kind === "observed"
+          ? i.status === "observed"
+          : i.status !== "observed")) &&
+      (!horizon ||
+        (horizon === "2040+" ? i.year >= 2040 : String(i.year) === horizon)),
+  );
+  const packages = latestUnified(editions).flatMap(
+    (e) => e.unified!.futureDocuments,
+  );
+  return (
+    <section className="unified-timeline">
+      <p className="eyebrow">OBSERVATIONS ET POSSIBILITÉS, DISTINCTES</p>
+      <h2>Chronologie IA & Futur</h2>
+      <p>
+        Une hypothèse n’est pas un fait. Les preuves, objections et conditions
+        restent celles des documents. Aucun score « vers AGI ».
+      </p>
+      <div
+        className="unified-controls"
+        role="group"
+        aria-label="Nature de la chronologie"
+      >
+        {[
+          ["all", "Tout"],
+          ["observed", "Faits observés"],
+          ["trajectories", "Trajectoires"],
+        ].map(([id, label]) => (
+          <button
+            className="secondary"
+            key={id}
+            aria-pressed={kind === id}
+            onClick={() => setKind(id)}
+          >
+            {label}
+          </button>
+        ))}
+      </div>
+      <div
+        className="unified-controls"
+        role="group"
+        aria-label="Horizons IA et Futur"
+      >
+        {["", "2027", "2030", "2035", "2040+"].map((y) => (
+          <button
+            className="secondary"
+            key={y}
+            aria-pressed={horizon === y}
+            onClick={() => setHorizon(y)}
+          >
+            {y || "Toutes les dates"}
+          </button>
+        ))}
+      </div>
+      <div className="unified-insights">
+        {rows.slice(0, compact ? 3 : 50).map((i) => (
+          <article className="unified-panel" key={i.id}>
+            <span className="unified-badge">
+              {i.year} · {statusLabels[i.status]}{" "}
+              {i.synthetic ? "· SYNTHÉTIQUE" : ""}
+            </span>
+            <h3>{i.title}</h3>
+            <p>{i.description}</p>
+            <p>
+              Observation : {i.observedAt || "non établie"} · Publication :{" "}
+              {i.publishedAt || "non renseignée"} · Vérification :{" "}
+              {i.verifiedAt || "non renseignée"}
+            </p>
+            <details>
+              <summary>Preuves, objections et invalidation</summary>
+              <p>Objections : {i.objections || "Non renseignées"}</p>
+              <p>
+                Déclencheur : {i.trigger || "Non renseigné"} · Invalidation :{" "}
+                {i.invalidation || "Non renseignée"}
+              </p>
+              {i.evidence.length ? (
+                i.evidence.map((s) => (
+                  <p key={s.id}>
+                    <a href={s.url} target="_blank" rel="noopener noreferrer">
+                      {s.label}
+                    </a>{" "}
+                    · {s.publishedAt}
+                  </p>
+                ))
+              ) : (
+                <p>Aucune preuve fournie : hypothèse non certifiée.</p>
+              )}
+            </details>
+            {i.futureDocumentId &&
+              docs.some((d) => d.documentId === i.futureDocumentId) && (
+                <button
+                  className="secondary"
+                  onClick={() => onFuture(i.futureDocumentId)}
+                >
+                  Ouvrir le dossier lié
+                </button>
+              )}
+          </article>
+        ))}
+      </div>
+      {!rows.length && (
+        <p>
+          Aucun jalon importé pour cette sélection. Aucune trajectoire n’est
+          inventée.
+        </p>
+      )}
+      <h3>Dossiers de l’atlas existant</h3>
+      {loadError && (
+        <p role="alert">
+          L’atlas est indisponible ; vos journaux restent accessibles.{" "}
+          {loadError}
+        </p>
+      )}
+      {docs.slice(0, compact ? 3 : 20).map((d) => (
+        <button
+          className="unified-result"
+          key={d.documentId}
+          onClick={() => onFuture(d.documentId)}
+        >
+          <b>{d.title}</b>
+          <span>
+            {statusLabels[d.status]} · révision {d.revision} · {d.updatedAt}
+            {d.synthetic ? " · SYNTHÉTIQUE" : ""}
+          </span>
+        </button>
+      ))}
+      <button className="secondary" onClick={() => onFuture()}>
+        Explorer tout l’atlas et ses versions
+      </button>
+      {packages.length > 0 && (
+        <details>
+          <summary>Transférer un dossier Future validé</summary>
+          <p>
+            Exportez le JSON, puis utilisez l’import Le Futur avec confirmation.
+            Les notes et sauvegardes restent séparées ; aucune écriture
+            simultanée entre bases.
+          </p>
+          {packages.map((p) => (
+            <button
+              className="secondary"
+              key={p.documentId + ":" + p.revision}
+              onClick={() => {
+                try {
+                  const checked = validateFuture(p);
+                  download(
+                    new Blob([JSON.stringify(checked, null, 2)], {
+                      type: "application/json",
+                    }),
+                    "Future-" + p.documentId + ".json",
+                  );
+                  setError("");
+                } catch (e) {
+                  setError(String(e));
+                }
+              }}
+            >
+              Exporter Future JSON : {p.title}
+            </button>
+          ))}
+        </details>
+      )}
+      {error && <p role="alert">{error}</p>}
+    </section>
+  );
+}
diff --git a/src/features/unified/PromptAccess.tsx b/src/features/unified/PromptAccess.tsx
new file mode 100644
index 0000000..ff47a7a
--- /dev/null
+++ b/src/features/unified/PromptAccess.tsx
@@ -0,0 +1,168 @@
+import { useState, useRef } from "react";
+import type { Edition } from "../../data/model";
+import { hash } from "../../data/model";
+import { db } from "../../data/db";
+import { download } from "../backup";
+import {
+  extractVscodePrompts,
+  vscodePromptFilename,
+  type VscodePrompt,
+} from "../vscodePrompt";
+export function PromptAccess({
+  edition,
+  eventId,
+}: {
+  edition: Edition;
+  eventId?: string;
+}) {
+  const [loaded, setLoaded] = useState<VscodePrompt[] | null>(
+      () =>
+        edition.unified?.promptAssets.map((p) => ({ ...p, id: p.promptId })) ??
+        null,
+    ),
+    [error, setError] = useState(""),
+    [busy, setBusy] = useState(false);
+  const prompts = loaded?.filter((p) => !eventId || p.eventId === eventId);
+  async function load() {
+    setBusy(true);
+    setError("");
+    try {
+      const o = await db.originals.get(edition.id);
+      if (!o)
+        throw Error("Le HTML original est indisponible sur cet appareil.");
+      setLoaded(extractVscodePrompts(o.bytes));
+    } catch (e) {
+      setError(
+        e instanceof Error ? e.message : "Lecture des prompts impossible.",
+      );
+    } finally {
+      setBusy(false);
+    }
+  }
+  return (
+    <div className="prompt-access">
+      {loaded === null && (
+        <button
+          className="text-button"
+          disabled={busy}
+          onClick={() => void load()}
+        >
+          {busy ? "Lecture des prompts…" : "Voir les prompts VS Code"}
+        </button>
+      )}
+      {error && <p role="alert">{error}</p>}
+      {prompts?.length === 0 && (
+        <p role="status" className="muted">
+          Aucun prompt VS Code identifiable dans ce document.
+        </p>
+      )}
+      {prompts?.map((p, i) => (
+        <PromptCard
+          key={p.id}
+          prompt={p}
+          filename={
+            edition.unified
+              ? p.filename
+              : loaded?.length === 1
+                ? vscodePromptFilename(edition.filename)
+                : vscodePromptFilename(edition.filename).replace(
+                    ".md",
+                    `_${i + 1}.md`,
+                  )
+          }
+        />
+      ))}
+    </div>
+  );
+}
+function safeFilename(value: string) {
+  return value
+    .split(/[\\/]/)
+    .pop()!
+    .replace(/[<>:"|?*]/g, "_")
+    .replace(/\p{Cf}/gu, "_")
+    .split("")
+    .map((c) => (c.charCodeAt(0) < 32 ? "_" : c))
+    .join("")
+    .slice(0, 220)
+    .replace(/(?:\.md)?$/i, ".md");
+}
+export function PromptCard({
+  prompt: p,
+  filename,
+}: {
+  prompt: VscodePrompt;
+  filename: string;
+}) {
+  const [notice, setNotice] = useState(""),
+    [digest, setDigest] = useState(""),
+    [busy, setBusy] = useState(false);
+  const area = useRef<HTMLTextAreaElement>(null);
+  function select() {
+    area.current?.focus();
+    area.current?.select();
+    setNotice("Texte sélectionné. Utilisez Cmd+C ou Ctrl+C.");
+  }
+  async function copy() {
+    try {
+      if (!navigator.clipboard?.writeText) throw Error();
+      await navigator.clipboard.writeText(p.content);
+      setNotice("Prompt complet copié. Aucune transmission externe.");
+    } catch {
+      select();
+    }
+  }
+  async function save() {
+    setBusy(true);
+    try {
+      const checksum = await hash(new TextEncoder().encode(p.content));
+      if (p.sha256 && p.sha256 !== checksum)
+        throw Error("Prompt tronqué ou checksum Markdown invalide.");
+      setDigest(checksum);
+      download(
+        new Blob([p.content], { type: "text/markdown;charset=utf-8" }),
+        safeFilename(filename),
+      );
+      setNotice(
+        "Téléchargement du prompt lancé. Vérifiez le fichier dans votre navigateur.",
+      );
+    } catch (e) {
+      setNotice(
+        e instanceof Error
+          ? e.message
+          : "Téléchargement impossible. Le texte reste sélectionnable.",
+      );
+    } finally {
+      setBusy(false);
+    }
+  }
+  return (
+    <article className="prompt-card">
+      <h3>{p.title}</h3>
+      <p className="small-note">
+        Texte intégral · privé à cet appareil · aucune exécution ni envoi à
+        Google
+      </p>
+      <details>
+        <summary>Voir et sélectionner le prompt complet</summary>
+        <label>
+          Prompt complet : {p.title}
+          <textarea ref={area} readOnly value={p.content} rows={14} />
+        </label>
+        <div className="settings-actions">
+          <button className="secondary" onClick={() => void copy()}>
+            Copier
+          </button>
+          <button className="secondary" onClick={select}>
+            Sélectionner
+          </button>
+        </div>
+      </details>
+      <button className="secondary" disabled={busy} onClick={() => void save()}>
+        Télécharger le prompt VS Code (.md)
+      </button>
+      {digest && <p className="hash-text small-note">SHA-256 : {digest}</p>}
+      <p role="status">{notice}</p>
+    </article>
+  );
+}
diff --git a/src/features/unified/UnifiedSearch.tsx b/src/features/unified/UnifiedSearch.tsx
new file mode 100644
index 0000000..c609cba
--- /dev/null
+++ b/src/features/unified/UnifiedSearch.tsx
@@ -0,0 +1,317 @@
+import { useMemo, useState, useEffect } from "react";
+import type { Edition } from "../../data/model";
+import {
+  indexArticles,
+  normalizeArticleSearch as normalize,
+} from "../../data/articles";
+import { futureDb } from "../future/db";
+import { economicRows, latestUnified } from "./selectors";
+import { PromptAccess } from "./PromptAccess";
+export function PromptLibrary({ editions }: { editions: Edition[] }) {
+  const [query, setQuery] = useState(""),
+    [selected, setSelected] = useState("");
+  const candidates = [
+    ...latestUnified(editions),
+    ...editions.filter((e) => !e.unified),
+  ].filter(
+    (e) =>
+      !e.deleted &&
+      (e.unified
+        ? e.unified.promptAssets.length > 0
+        : e.collection === "sentinel"),
+  );
+  const filtered = candidates.filter((e) =>
+    normalize(
+      e.title +
+        " " +
+        e.text +
+        " " +
+        JSON.stringify(e.unified?.promptAssets || []),
+    ).includes(normalize(query)),
+  );
+  const edition = candidates.find((e) => e.id === selected);
+  return (
+    <section>
+      <h2>Mes prompts .md</h2>
+      <p>
+        Texte intégral conservé dans les originaux. Rien n’est exécuté ni
+        transmis à Google. Les anciennes cartes Sentinel peuvent être inspectées
+        sans réimport.
+      </p>
+      <label>
+        Rechercher un prompt
+        <input
+          type="search"
+          value={query}
+          onChange={(e) => setQuery(e.target.value)}
+        />
+      </label>
+      <p role="status">
+        {filtered.length} document(s) candidat(s). Les anciens HTML sont
+        vérifiés à l’ouverture.
+      </p>
+      <div className="unified-prompt-layout">
+        <div>
+          {filtered.slice(0, 100).map((e) => (
+            <button
+              className="unified-result"
+              key={e.id}
+              aria-pressed={selected === e.id}
+              onClick={() => setSelected(e.id)}
+            >
+              <b>{e.title}</b>
+              <span>
+                {e.date || "Date inconnue"} ·{" "}
+                {e.unified
+                  ? e.unified.promptAssets.length + " prompts"
+                  : "HTML ancien à inspecter"}
+                {e.archived ? " · Archive" : ""}
+              </span>
+            </button>
+          ))}
+          {filtered.length > 100 && (
+            <p>100 documents affichés : précisez la recherche.</p>
+          )}
+        </div>
+        <div>
+          {edition ? (
+            <PromptAccess key={edition.id} edition={edition} />
+          ) : (
+            <p>
+              Choisissez un document pour voir, copier, sélectionner ou
+              télécharger chaque prompt.
+            </p>
+          )}
+        </div>
+      </div>
+    </section>
+  );
+}
+type Row = {
+  key: string;
+  kind: string;
+  title: string;
+  text: string;
+  date: string;
+  source: string;
+  status: string;
+  theme: string;
+  open: () => void;
+};
+export function UnifiedSearch({
+  editions,
+  onOpen,
+  onFuture,
+  onPrompts,
+}: {
+  editions: Edition[];
+  onOpen: (id: string, article?: string) => void;
+  onFuture: (id?: string) => void;
+  onPrompts: () => void;
+}) {
+  const [query, setQuery] = useState(""),
+    [kind, setKind] = useState(""),
+    [date, setDate] = useState(""),
+    [source, setSource] = useState(""),
+    [status, setStatus] = useState(""),
+    [theme, setTheme] = useState(""),
+    [sort, setSort] = useState("relevance"),
+    [futureRows, setFutureRows] = useState<Row[]>([]),
+    [error, setError] = useState(""),
+    [indexing, setIndexing] = useState(false),
+    [limit, setLimit] = useState(30);
+  // Full-text on public/imported payloads, no personal notes, no network or model.
+  useEffect(() => {
+    let active = true;
+    setIndexing(true);
+    setError("");
+    (async () => {
+      const docs = await futureDb.documents.toArray();
+      const rows: Row[] = [];
+      for (let i = 0; i < docs.length; i += 25) {
+        const batch = docs.slice(i, i + 25),
+          contents = await futureDb.contents.bulkGet(
+            batch.map((d) => d.latest),
+          );
+        for (let j = 0; j < batch.length; j++) {
+          const d = batch[j],
+            p = contents[j]?.payload;
+          if (!p) throw Error("Snapshot Future manquant.");
+          rows.push({
+            key: "future:" + d.documentId,
+            kind: "Future",
+            title: d.title,
+            text: JSON.stringify(p),
+            date: d.updatedAt.slice(0, 10),
+            source: "future",
+            status: d.status,
+            theme: "Prospective",
+            open: () => onFuture(d.documentId),
+          });
+        }
+        if (!active) return;
+        await new Promise((r) => setTimeout(r, 0));
+      }
+      if (active) setFutureRows(rows);
+    })()
+      .catch(() => {
+        if (active)
+          setError(
+            "Index Future indisponible ; les autres recherches restent locales et accessibles.",
+          );
+      })
+      .finally(() => {
+        if (active) setIndexing(false);
+      });
+    return () => {
+      active = false;
+    };
+  }, [onFuture]);
+  const rows = useMemo(() => {
+    const result: Row[] = indexArticles(editions).map((i) => ({
+      key: i.key,
+      kind: "Article",
+      title: i.article.title,
+      text: i.article.text + " " + i.article.sources.join(" "),
+      date: i.edition.date || "",
+      source: i.article.sourceWatch || i.edition.collection || "journal360",
+      status:
+        i.edition.unified?.items.find((a) => a.eventId === i.article.eventId)
+          ?.evidenceStatus || "legacy",
+      theme: i.article.category,
+      open: () => onOpen(i.edition.id, i.article.id),
+    }));
+    for (const { data: e, edition } of economicRows(editions))
+      result.push({
+        key: "eco:" + e.id + e.period + edition.id,
+        kind: "Économie",
+        title: e.indicator + " · " + e.zone,
+        text: JSON.stringify(e),
+        date: e.statisticDate,
+        source: "journal360",
+        status: e.status,
+        theme: "Économie",
+        open: () => onOpen(edition.id),
+      });
+    for (const e of latestUnified(editions)) {
+      for (const p of e.unified!.promptAssets)
+        result.push({
+          key: "prompt:" + p.promptId + e.date,
+          kind: "Prompt",
+          title: p.title,
+          text: p.content,
+          date: e.date || "",
+          source: p.product,
+          status: "intégral",
+          theme: "Prompts",
+          open: onPrompts,
+        });
+      for (const i of e.unified!.futureInsights)
+        result.push({
+          key: "insight:" + i.id + e.date,
+          kind: "Jalon",
+          title: i.title,
+          text: JSON.stringify(i),
+          date: i.observedAt || i.publishedAt || e.date || "",
+          source: "future",
+          status: i.status,
+          theme: "Prospective",
+          open: () => onOpen(e.id),
+        });
+    }
+    return [...result, ...futureRows];
+  }, [editions, futureRows, onOpen, onPrompts]);
+  const tokens = normalize(query).trim().split(/\s+/).filter(Boolean);
+  const matching = rows
+    .filter(
+      (r) =>
+        (!kind || kind === r.kind) &&
+        (!date || r.date === date) &&
+        (!source || r.source === source) &&
+        (!status || r.status === status) &&
+        (!theme || r.theme === theme) &&
+        tokens.every((t) => normalize(r.title + " " + r.text).includes(t)),
+    )
+    .sort((a, b) =>
+      sort === "date"
+        ? b.date.localeCompare(a.date)
+        : Number(normalize(b.title).includes(normalize(query))) -
+            Number(normalize(a.title).includes(normalize(query))) ||
+          b.date.localeCompare(a.date),
+    );
+  return (
+    <section>
+      <h2>Recherche globale locale</h2>
+      <p>
+        Articles, sources, signaux et scénarios Future, économie, jalons et
+        prompts. Recherche textuelle sans accents ni casse ; aucun service IA
+        n’est appelé.
+      </p>
+      <label>
+        Rechercher partout
+        <input
+          type="search"
+          value={query}
+          onChange={(e) => {
+            setQuery(e.target.value);
+            setLimit(30);
+          }}
+        />
+      </label>
+      <details>
+        <summary>Filtres de la recherche globale</summary>
+        <div className="unified-filters">
+          {[
+            ["Type", kind, setKind, rows.map((r) => r.kind)],
+            ["Date", date, setDate, rows.map((r) => r.date)],
+            ["Provenance", source, setSource, rows.map((r) => r.source)],
+            ["Statut", status, setStatus, rows.map((r) => r.status)],
+            ["Thème", theme, setTheme, rows.map((r) => r.theme)],
+          ].map(([label, value, set, options]) => (
+            <label key={String(label)}>
+              {String(label)}
+              <select
+                value={value as string}
+                onChange={(e) => {
+                  (set as (v: string) => void)(e.target.value);
+                  setLimit(30);
+                }}
+              >
+                <option value="">Tous</option>
+                {[...new Set(options as string[])]
+                  .filter(Boolean)
+                  .sort()
+                  .map((v) => (
+                    <option key={v}>{v}</option>
+                  ))}
+              </select>
+            </label>
+          ))}
+          <label>
+            Tri
+            <select value={sort} onChange={(e) => setSort(e.target.value)}>
+              <option value="relevance">Pertinence textuelle</option>
+              <option value="date">Date</option>
+            </select>
+          </label>
+        </div>
+      </details>
+      {indexing && <p role="status">Indexation locale des dossiers Future…</p>}
+      {error && <p role="alert">{error}</p>}
+      <p role="status">{matching.length} résultat(s) · aucun envoi externe</p>
+      {matching.slice(0, limit).map((r) => (
+        <button className="unified-result" key={r.key} onClick={r.open}>
+          <b>{r.title}</b>
+          <span>
+            {r.kind} · {r.date || "date inconnue"} · {r.source} · {r.status}
+          </span>
+        </button>
+      ))}
+      {matching.length > limit && (
+        <button className="secondary" onClick={() => setLimit((n) => n + 30)}>
+          Afficher 30 résultats de plus
+        </button>
+      )}
+    </section>
+  );
+}
