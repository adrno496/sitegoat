# Client : uniquement la clé publique, jamais de secret dans VITE_*.
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=votre-cle-publique
# Serveur Vercel uniquement. Ces variables ne sont pas intégrées au bundle client.
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_SECRET_KEY=votre-cle-serveur
JOURNAL360_ACCOUNT_EMAIL=compte-prive@example.com

# Optional server-side online sources; never prefix these keys with VITE_.
# Production values are sensitive Vercel environment variables.
BRAVE_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=
