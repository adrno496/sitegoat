{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "journal360.future"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "documentId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,199}$"
    },
    "revision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 1000000
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "status": {
      "type": "string",
      "enum": [
        "observed",
        "hypothesis",
        "scenario"
      ]
    },
    "synthetic": {
      "default": false,
      "type": "boolean"
    },
    "editorialDecision": {
      "type": "object",
      "properties": {
        "verdict": {
          "type": "string",
          "enum": [
            "integrer",
            "surveiller",
            "ecarter"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      },
      "required": [
        "verdict",
        "reason"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "originType": {
          "type": "string",
          "enum": [
            "video",
            "article",
            "report",
            "podcast",
            "web",
            "manual"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "originalUrl": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            {
              "type": "null"
            }
          ]
        },
        "author": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 300
            },
            {
              "type": "null"
            }
          ]
        },
        "publishedAt": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "providedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "sources": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,199}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "url": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "publisher": {
                "default": "Non renseigné",
                "type": "string",
                "maxLength": 300
              },
              "author": {
                "default": null,
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 300
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "publishedAt": {
                "default": null,
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": {
                "default": "unknown",
                "type": "string",
                "enum": [
                  "primary",
                  "secondary",
                  "unknown"
                ]
              },
              "consultedAt": {
                "default": null,
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "id",
              "label",
              "url"
            ],
            "additionalProperties": false
          }
        },
        "legacyFormat": {
          "type": "string",
          "const": "ai-radar"
        }
      },
      "required": [
        "originType",
        "title",
        "originalUrl",
        "author",
        "publishedAt",
        "providedAt",
        "sources"
      ],
      "additionalProperties": false
    },
    "scenarios": {
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,199}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "path": {
            "type": "string",
            "enum": [
              "acceleration",
              "moderate",
              "slowdown",
              "other"
            ]
          },
          "horizon": {
            "type": "string",
            "enum": [
              "2027",
              "2030",
              "2035",
              "2040+",
              "unspecified"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "hypothesis",
              "scenario"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "assumptions": {
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            }
          },
          "objections": {
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            }
          },
          "triggers": {
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            }
          },
          "indicators": {
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            }
          },
          "signalIds": {
            "default": [],
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,199}$"
            }
          },
          "milestones": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,199}$"
                },
                "year": {
                  "type": "integer",
                  "minimum": 2020,
                  "maximum": 2100
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 10000
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "observed",
                    "hypothesis",
                    "scenario"
                  ]
                },
                "evidenceUrls": {
                  "maxItems": 30,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                  }
                },
                "observedAt": {
                  "default": null,
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "id",
                "year",
                "title",
                "description",
                "status",
                "evidenceUrls"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "title",
          "path",
          "horizon",
          "status",
          "summary",
          "assumptions",
          "objections",
          "triggers",
          "indicators",
          "milestones"
        ],
        "additionalProperties": false
      }
    },
    "signals": {
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,199}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "status": {
            "type": "string",
            "enum": [
              "observed",
              "watch",
              "contradicted",
              "unknown"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "evidenceUrls": {
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          },
          "lastCheckedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              {
                "type": "null"
              }
            ]
          },
          "checkNote": {
            "default": "",
            "type": "string",
            "maxLength": 4000
          }
        },
        "required": [
          "id",
          "title",
          "status",
          "description",
          "evidenceUrls",
          "lastCheckedAt"
        ],
        "additionalProperties": false
      }
    },
    "actions": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,199}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "horizon": {
            "type": "string",
            "enum": [
              "now",
              "3m",
              "12m"
            ]
          },
          "skill": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 6000
          },
          "effortHours": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 10000
              },
              {
                "type": "null"
              }
            ]
          },
          "effortEvidence": {
            "default": "",
            "type": "string",
            "maxLength": 4000
          },
          "decisiveTest": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "scenarioIds": {
            "default": [],
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,199}$"
            }
          }
        },
        "required": [
          "id",
          "title",
          "horizon",
          "skill",
          "description",
          "effortHours",
          "decisiveTest"
        ],
        "additionalProperties": false
      }
    },
    "visualization": {
      "type": "object",
      "properties": {
        "modules": {
          "minItems": 1,
          "maxItems": 6,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "timeline",
              "scenarios",
              "signals",
              "actions",
              "changes",
              "sources"
            ]
          }
        },
        "motion": {
          "type": "string",
          "enum": [
            "subtle",
            "off"
          ]
        },
        "links": {
          "default": [],
          "maxItems": 200,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,199}$"
              },
              "to": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,199}$"
              },
              "label": {
                "type": "string",
                "maxLength": 500
              }
            },
            "required": [
              "from",
              "to",
              "label"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "modules",
        "motion"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "format",
    "version",
    "documentId",
    "revision",
    "updatedAt",
    "title",
    "status",
    "editorialDecision",
    "provenance",
    "scenarios",
    "signals",
    "actions",
    "visualization"
  ],
  "additionalProperties": false
}
